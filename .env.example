# Local Next.js dev. Copy to .env.local. Do not commit keys.
# Production: wrangler secret put MUSE_API_KEY
# Production: wrangler secret put SITE_PASSWORD

MUSE_API_KEY=
# Gate password. Must match .dev.vars. `next dev` reads .env.local; wrangler reads .dev.vars.
SITE_PASSWORD=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3-contributor
MUSE_REASONING_EFFORT=medium
MUSE_TIMEOUT_MS=90000

# Scan chunking (optional)
SCAN_TARGET_TOKENS_MIN=450
SCAN_TARGET_TOKENS_MAX=650
SCAN_CONTEXT_TOKENS=100
SCAN_CONCURRENCY=2
SCAN_RETRY_LIMIT=2
SCAN_REVIEW_ENABLED=false

