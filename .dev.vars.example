NEXTJS_ENV=development
MUSE_API_KEY=
# Must match .env.local for `npm run dev`
SITE_PASSWORD=
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3-contributor
MUSE_REASONING_EFFORT=medium
MUSE_TIMEOUT_MS=90000

# Scan chunking (optional)
SCAN_TARGET_TOKENS_MIN=450
SCAN_TARGET_TOKENS_MAX=650
SCAN_CONTEXT_TOKENS=100
SCAN_CONCURRENCY=2
SCAN_RETRY_LIMIT=2
SCAN_REVIEW_ENABLED=false

